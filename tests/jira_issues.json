{"issues": [{"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10478", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10478", "key": "VOR-53", "fields": {"summary": "W3-12 \u00b7 Closure validation and README verification (1h)", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Verify that the whole system can be rebuilt from scratch following only the README, and close the decision record for the three weeks. Acceptance criteria: full rebuild executed cold following only the README, ideally by someone outside the cell; ADR covers all three weeks and includes the CI/CD platform criterion, the scaling metric chosen, which component saturates first under load with its mitigation, and what the cell would do differently starting over. Owner Argenis. Estimate 1h."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-28T11:52:44.596-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10477", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10477", "key": "VOR-52", "fields": {"summary": "W3-11 \u00b7 Final credit report (1h)", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Report the total credit consumed by the project so that the cost constraint is demonstrably met. Acceptance criteria: total project consumption under 60 USD; the week 3 peak explained by its causes such as load tests, image builds and telemetry; remaining margin stated. Owner Argenis. Estimate 1h."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-28T11:52:41.764-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10476", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10476", "key": "VOR-51", "fields": {"summary": "W3-10 \u00b7 Alert configured and proven (2h)", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Configure one alert on a condition that genuinely requires human intervention so that silent failures surface. Acceptance criteria: condition, threshold and justification documented; the alert fires when the condition is deliberately provoked; telemetry free tier limit and estimated consumption documented. Owner Argenis. Estimate 2h."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-28T11:52:39.642-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10475", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10475", "key": "VOR-50", "fields": {"summary": "W3-09 \u00b7 Distributed trace per transaction (4h)", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Make the full journey of a single transaction visible by its identifier with per stage timings so that any failure point is locatable. This is a closure criterion of the project. Acceptance criteria: given a transaction id, the trace shows API, messaging, engine, stores and explainer with the time spent in each; the slowest component is identifiable; aggregate dashboards alone do not satisfy this requirement. Owner Argenis. Estimate 4h. Depends on W3-08."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-28T11:52:36.561-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10436", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10436", "key": "VOR-40", "fields": {"summary": "W2-09 \u00b7 Decoupling and queue durability proof (4h)", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reproducible procedure proving the pipeline is decoupled and loses nothing, so the architectural requirement is verified rather than assumed. Acceptance criteria: timestamps show the API responded before the engine finished; with the case consumer stopped the API keeps accepting transactions; when the consumer restarts every queued case is processed with no losses. Evidence: timestamps plus queue message count while stopped and then zero. Owner Argenis. Estimate 4h. Depends on W2-08."}], "attrs": {"localId": "089fe5b0756b"}}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-27T17:31:21.422-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10426", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10426", "key": "VOR-30", "fields": {"summary": "US-605 \u00b7 Closure validation (10-step sequence)", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "As QA, I want the Week 1 closing sequence executed and logged, so that any step requiring undocumented knowledge surfaces as pending work."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Acceptance criteria \u2014 execute in order and record results:", "marks": [{"type": "em"}]}]}, {"type": "orderedList", "attrs": {"order": 1}, "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Delete the entire resource group."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Run the provisioning script on the empty subscription."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Complete configuration following ONLY the README."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Send a valid transaction and verify persistence."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Send an invalid transaction and verify rejection."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Upload a document and verify arrival in the container."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Write and read a queue message."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Attempt to reach storage from the internet and verify the block."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Query and record consumed credit."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Run the shutdown script."}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Any step requiring undocumented knowledge becomes a new task. Owner: D (QA), all support. Maps to Section 4 of the Week 1 document."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-27T17:31:19.947-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10425", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10425", "key": "VOR-29", "fields": {"summary": "US-604 \u00b7 Deployment README", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "As a third party, I want a README that lets me clone the repository and bring up the whole system without undocumented knowledge, so that the infrastructure is fully reproducible."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Acceptance criteria", "marks": [{"type": "em"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Steps: clone \u2192 edit parameters (unique suffix) \u2192 run provision.sh \u2192 deploy API \u2192 test \u2192 shutdown."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No credentials anywhere in code, repo or git history."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Verified during closure validation (US-605): full rebuild following only the README."}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Maps to Deliverable 26. Owner: D."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a7-e77f-4c5c-aa4d-95ed661dc252", "emailAddress": "argenisdavid212@gmail.com", "avatarUrls": {"48x48": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "24x24": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "16x16": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png", "32x32": "https://secure.gravatar.com/avatar/6133ebe3e6a9e0e86cb8eebe560b0ef3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAD-6.png"}, "displayName": "Argenis David", "active": true, "timeZone": "America/Bogota", "accountType": "atlassian"}, "updated": "2026-07-27T17:20:56.396-0500", "status": {"self": "https://juangira15.atlassian.net/rest/api/3/status/10104", "description": "", "iconUrl": "https://juangira15.atlassian.net/images/icons/statuses/generic.png", "name": "Por hacer", "id": "10104", "statusCategory": {"self": "https://juangira15.atlassian.net/rest/api/3/statuscategory/2", "id": 2, "key": "new", "colorName": "blue-gray", "name": "To Do"}}, "labels": []}}, {"expand": "renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations", "id": "10424", "self": "https://juangira15.atlassian.net/rest/api/3/issue/10424", "key": "VOR-28", "fields": {"summary": "US-603 \u00b7 Architecture Decision Record (ADR) started", "description": {"type": "doc", "version": 1, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "As a team, we want an Architecture Decision Record started in Week 1 and maintained across the three weeks, so that every significant decision (region, tier, contract, isolation mechanism, queue choice) has recorded context and justification."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Acceptance criteria", "marks": [{"type": "em"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ADR file in the repo with entries for Week 1 decisions: subscription type, region, B1 tier, LRS, service endpoints vs private endpoints, Storage Queue vs Service Bus, contract decisions, unknown-fields policy, shutdown responsibility rotation."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Format: context \u2192 decision \u2192 consequences."}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Maps to Deliverable 25. Owner: D, all contribute."}]}]}, "assignee": {"self": "https://juangira15.atlassian.net/rest/api/3/user?accountId=712020%3Ad46a91a7-e77f-4c5c-aa4d-95ed661dc252", "accountId": "712020:d46a91a